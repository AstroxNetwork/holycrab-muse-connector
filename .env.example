# ── Required ─────────────────────────────────────────────────────────
# ≥32 characters. Signs the connector tokens users paste into Muse.
# Rotating it invalidates every issued token, so treat it like a root key.
#   openssl rand -base64 48
CONNECTOR_SECRET=

# The address Muse will call. This becomes the OpenAPI `servers` entry, so it
# must be the URL you actually deploy to — not a placeholder.
PUBLIC_URL=https://muse.example.com

# Where users go to review or revoke access. It is printed to them in
# /llms.txt and in every 401, so it must be a page you control.
DASHBOARD_URL=https://example.com

# Shown in the OpenAPI title, /health and llms.txt. Defaults to "Muse Connector".
SERVICE_NAME=

# Shared secret your dashboard backend sends to POST /v1/link (server-to-server).
LINK_SECRET=

# ── Persistence ──────────────────────────────────────────────────────
# Without one of these the connector keeps connections in memory, which
# breaks on serverless (fresh isolate per request) and loses revocations
# on restart. Fine for local dev only.
#
# Vercel KV / Upstash Redis (REST):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

PORT=8787
