# Required — ≥32 characters. Signs the connector tokens users paste into Muse.
# Rotating this invalidates every issued token, so treat it like a root key.
CONNECTOR_SECRET=replace-with-at-least-32-random-characters

PORT=8787
PUBLIC_URL=https://muse.holycrab.ai
DASHBOARD_URL=https://holycrab.ai

# Shared secret your dashboard backend sends to POST /v1/link (server-to-server).
LINK_SECRET=replace-me

# ── Persistence ──────────────────────────────────────────────────────
# Without one of these the connector keeps connections in memory, which
# breaks on serverless (fresh isolate per request) and loses revocations
# on restart. Fine for local dev only.
#
# Vercel KV / Upstash Redis (REST):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
