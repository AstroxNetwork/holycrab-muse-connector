{
  "name": "muse-connector-template",
  "version": "0.1.0",
  "description": "Deployable connector template for Meta Muse — per-connection tokens, async job scaffolding, one registry generating routes, OpenAPI and llms.txt.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "muse-connector": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "connector"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json",
    "deploy:cf": "wrangler deploy",
    "deploy:vercel": "vercel deploy --prod"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "wrangler": "^4.137.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AstroxNetwork/muse-connector-template.git"
  },
  "homepage": "https://github.com/AstroxNetwork/muse-connector-template",
  "keywords": [
    "muse",
    "meta",
    "connector",
    "agent",
    "openapi",
    "template",
    "astroxnetwork"
  ]
}
